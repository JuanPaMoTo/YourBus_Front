{
  "name": "bus-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src",
    "test": "vitest run",
    "preview": "vite preview",
    "prepare": "husky || true",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "oxlint",
      "prettier --write"
    ]
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.10",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}